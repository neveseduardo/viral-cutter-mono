{
    "$schema": "https://opencode.ai/config.json",
    "tui": {
        "show_thinking": false
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--headless",
                "--isolated"
            ]
        }
    }
}