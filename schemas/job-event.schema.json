{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralcutter.dev/schemas/job-event.schema.json",
  "title": "Job Progress Event (SSE)",
  "description": "Payload dos eventos SSE de progresso (§8.6).",
  "type": "object",
  "required": ["schema_version", "pipeline_run_id", "job_id", "stage", "status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "pipeline_run_id": { "type": ["string", "integer"] },
    "job_id": { "type": ["string", "integer"] },
    "stage": { "type": "string" },
    "queue": { "enum": ["io", "cpu", "gpu"] },
    "status": { "enum": ["pending", "running", "succeeded", "failed", "cancelled", "skipped"] },
    "attempt": { "type": ["integer", "null"], "minimum": 0 },
    "progress": { "type": "number", "minimum": 0, "maximum": 100 },
    "message": { "type": "string" },
    "error": { "type": ["string", "null"] }
  }
}