{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralcutter.dev/schemas/viral-segments.schema.json",
  "title": "Viral Segments",
  "description": "Segmentos virais selecionados pela IA com score decomposto (§8.2).",
  "type": "object",
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "score"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 255 },
          "hook": { "type": "string" },
          "reasoning": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "scores": {
            "type": "object",
            "properties": {
              "hook": { "type": "number", "minimum": 0, "maximum": 100 },
              "story": { "type": "number", "minimum": 0, "maximum": 100 },
              "emotion": { "type": "number", "minimum": 0, "maximum": 100 },
              "standalone": { "type": "number", "minimum": 0, "maximum": 100 },
              "shareability": { "type": "number", "minimum": 0, "maximum": 100 },
              "total": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "start_text": { "type": "string" },
          "end_text": { "type": "string" },
          "start_time_ref": { "type": ["string", "number", "null"] },
          "start_time": { "type": ["number", "null"], "minimum": 0 },
          "end_time": { "type": ["number", "null"], "minimum": 0 },
          "duration": { "type": ["number", "null"], "minimum": 0 },
          "rejected": { "type": "boolean" },
          "rejection_reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}