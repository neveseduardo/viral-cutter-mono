# ViralCutter — backend/.env.example
# Copie para backend/.env e preencha: cp .env.example .env
# Não versionar o .env (já está no .gitignore).
# O Django lê backend/.env em dev local; o Docker Compose injeta via env_file.

# ── Django ────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ── Auth (local single-user default) ─────────────────────
AUTH_DISABLED=true

# ── Database ─────────────────────────────────────────────
DB_ENGINE=postgres          # postgres | sqlite (dev local)
POSTGRES_DB=viralcutter
POSTGRES_USER=viralcutter
POSTGRES_PASSWORD=viralcutter
POSTGRES_HOST=db            # localhost em dev sem Docker
POSTGRES_PORT=5432

# ── Redis / Celery ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=5

# ── Storage ──────────────────────────────────────────────
STORAGE_QUOTA_MB=10240

# ── IA — Google Gemini (obrigatório para analyze) ────────
# Obtenha: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── IA — OpenAI / compatível ─────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── IA — Ollama (local, offline, sem chave) ──────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ── IA — failover (ordem de providers) ───────────────────
AI_FAILOVER=auto,gemini,openai,ollama,manual

# ── Transcrição (Whisper) ────────────────────────────────
WHISPER_MODEL=tiny

# ── GPU / FFmpeg ─────────────────────────────────────────
USE_GPU=false
CUDA_DEVICE=0
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_ENCODER=
LOCAL_LLM_MODELS_DIR=/data/models

# ── Tradução ─────────────────────────────────────────────
TRANSLATION_ENGINE=external   # offline | external
DEEPL_KEY=

# ── Limites e quotas ─────────────────────────────────────
MAX_UPLOAD_MB=4096
MAX_VIDEO_DURATION_S=7200
MAX_SEGMENTS=10
CONCURRENT_JOBS_LIMIT=2

# ── Misc ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
